{
  "$schema": "https://glama.ai/mcp/schema.json",
  "name": "tokenverify-mcp",
  "description": "Sub-50ms Edge B2B Trust, VAT/Tax Checksum & Fraud Prevention Gateway for Checkout Rails & AI Agents.",
  "homepage": "https://tokenverifyapi.com",
  "repository": "https://github.com/quitegoodproject/tokenverify",
  "transport": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@quitegoodproject/tokenverify-mcp@1.1.0"
    ],
    "env": {
      "TOKENVERIFY_API_KEY": "${TOKENVERIFY_API_KEY}",
      "TOKENVERIFY_EMAIL": "${TOKENVERIFY_EMAIL}"
    }
  },
  "tags": [
    "vat-validation",
    "fraud-prevention",
    "mcp",
    "ai-agents",
    "tax-checksum"
  ]
}